# Copy to .env and fill in. Never commit .env.
HARNESS_ENV=dev
HARNESS_LOG_LEVEL=INFO

# Comma-separated API keys accepted by the HTTP API (X-API-Key header). Required in prod.
HARNESS_API_KEYS=change-me-local-dev-key

# LLM providers. Only needed for real-model runs; tests and the offline demo use FakeLLM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HARNESS_LLM_TIMEOUT_S=60
HARNESS_LLM_MAX_RETRIES=3

# Storage: "memory" (single process, dev only) or "redis" (+ Postgres for long-term memory).
HARNESS_STORAGE_BACKEND=memory
HARNESS_REDIS_URL=redis://localhost:6379/0
HARNESS_DATABASE_URL=postgresql://harness:harness@localhost:5432/harness

# Sandbox: "docker" (default, isolated) or "local_unsafe" (NO isolation; dev only, needs opt-in).
HARNESS_SANDBOX_BACKEND=docker
HARNESS_SANDBOX_IMAGE=agent-harness-sandbox:latest
HARNESS_ALLOW_UNSAFE_SANDBOX=false

# Observability
HARNESS_OTEL_ENABLED=false
HARNESS_OTEL_ENDPOINT=http://localhost:4317
